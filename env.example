# ============================================
# LiS Chatbot - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# ============================================
# REQUIRED - Core functionality
# ============================================

# OpenAI API Key for chat functionality
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ============================================
# RECOMMENDED - Enhanced functionality
# ============================================

# Supabase Service Role Key (for admin operations)
# Found in Supabase > Settings > API > Service Role Key
# WARNING: Keep this secret! Never expose on client side
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Deepgram API Key for Speech-to-Text
# Get yours at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your-deepgram-api-key

# ElevenLabs API Key for Text-to-Speech
# Get yours at: https://elevenlabs.io/
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ============================================
# OPTIONAL - Additional configuration
# ============================================

# Application URL (for CORS and links)
# Set to your production URL when deploying
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# OPTIONAL - Security & Rate Limiting
# ============================================

# Upstash Redis (for distributed rate limiting in production)
# Get these from: https://console.upstash.com/
# Without these, rate limiting falls back to in-memory (not suitable for production)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# CORS allowed origins (comma-separated)
# Only these origins will be allowed to make API requests
ALLOWED_ORIGINS=https://lis-chatbot.vercel.app

# Node environment (automatically set by deployment platform)
# NODE_ENV=development

